
color sun = #FFDF22;
color birdColor = #F5F5EF;
color skyColor = #B4DCFF;
color pondColor = #28503C;

void setup() {
  size(800, 700);
  background(skyColor);
}

void draw() {
  noStroke();
  
  //pond
  fill(40,80,60);
  rect(0,height/2,width,height/2);
  
  
  //sun
  fill(sun);
  circle(90,60,90);
  
  
  
  
  
  
  
  
  
  
  
  
  
}
